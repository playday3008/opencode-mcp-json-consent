{
  "name": "opencode-mcp-json-consent",
  "version": "0.1.0",
  "private": true,
  "description": "Approval-gated project .mcp.json imports for OpenCode V2",
  "license": "MIT",
  "author": "PlayDay",
  "type": "module",
  "exports": "./src/index.js",
  "files": [
    "src/index.js",
    "src/config.js"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:integration": "uv run python tests/integration.py",
    "format": "prettier --write . && uv run ruff format .",
    "format:check": "prettier --check . && uv run ruff format --check .",
    "lint": "eslint . && uv run ruff check .",
    "typecheck": "tsc --noEmit && uv run mypy .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@opencode/plugin": "2.2.5",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  }
}
